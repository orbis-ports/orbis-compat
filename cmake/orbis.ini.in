# meson cross file for OpenOrbis (PS4). Generated from this template by build.sh - do not edit the
# generated copy, it is overwritten on every run.
#
# system = 'freebsd' because the triple IS freebsd12 and clang defines __FreeBSD__ 12 for it, so meson's
# own FreeBSD arms and Mesa's build plumbing work with no invention on our part.
#
# ⚠ THAT IS A STATEMENT ABOUT THE BUILD SYSTEM, NOT ABOUT util/. The PS4 is a FreeBSD *kernel* with a
# musl *libc*, and the two halves want opposite answers:
#
#   raw __FreeBSD__       - kept, and load-bearing. util/futex.{h,c} gate on it and take FreeBSD's
#                           _umtx_op arm, which orbis-compat's sys/umtx.h makes real over pthreads. The
#                           futex works rather than being disabled.
#   DETECT_OS_FREEBSD     - deliberately NOT set for this platform, in util/detect_os.h. That macro is
#                           what util/ uses to reach for FreeBSD's LIBC - sys/umtx.h's neighbours,
#                           machine/cpu.h, kinfo_file, KERN_PROC_ARGS - none of which exist here.
#
# Do not collapse those two into "Mesa's FreeBSD support carries this port". Thirteen of the port's last
# fourteen build errors were the second one being true when it should not have been.
# ⚠ THE COMPILER IS SUBSTITUTED, NOT HARDCODED, AND A nix devShell ON macOS IS WHY. build.sh runs
# meson through `nix develop nixpkgs#mesa`, so a bare `clang` resolves to nix's cc-wrapper. On
# x86_64-linux that wrapper is harmless. On aarch64-darwin it injects HOST flags into a cross
# compile and says so itself:
#
#     Warning: supplying the --target x86_64-pc-freebsd12-elf != arm64-apple-darwin argument to a
#     nix-wrapped compiler may not work correctly - cc-wrapper is currently not designed with
#     multi-target compilers in mind. You may want to use an un-wrapped compiler instead.
#
# ⚠ AND IT IS NOT A WARNING, IT IS EVERY FEATURE PROBE. meson compiles its checks with
# -Werror=unused-command-line-argument, and the wrapper adds -mmacos-version-min=15.0, which clang
# cannot use for this triple:
#
#     clang: error: argument unused during compilation: '-mmacos-version-min=15.0'
#            [-Werror,-Wunused-command-line-argument]
#     Check usable header "endian.h" : NO
#
# 168 checks came back NO against 66 YES, so config.h lost HAVE_ENDIAN_H and most of its neighbours.
# u_endian.h then fell past its <endian.h> arm into the FreeBSD one, reached for a
# <machine/endian.h> that neither this overlay nor the SDK ships, and the build ended with 1107
# failed targets and 2847 compile errors - none of which named the cause.
#
# @ORBIS_CC@ defaults to plain `clang`, so Linux CI is unchanged. Set ORBIS_CC/ORBIS_CXX to an
# un-wrapped compiler - Homebrew's `/opt/homebrew/opt/llvm/bin/clang` - to build on a Mac.
#
# ar and strip come from the devShell and are fine there: they are not passed --target, so the
# wrapper has nothing to mis-handle. They are substituted anyway, because a build that leaves the
# devShell needs llvm-ar rather than Apple's ar, which cannot write an ELF archive.
[binaries]
c       = '@ORBIS_CC@'
cpp     = '@ORBIS_CXX@'
ar      = '@ORBIS_AR@'
strip   = '@ORBIS_STRIP@'
pkg-config = 'pkg-config'
# cmake is DELIBERATELY unavailable. meson's dependency() falls back to cmake package files when
# pkg-config finds nothing, and nix's devShell carries cmake configs for HOST libraries - which is how
# zlib was 'found: YES 1.3.1.zlib-ng' for a PS4 build whose pkg-config correctly said no. A cross build
# has no business consulting the host's cmake registry.
cmake = 'false'

[host_machine]
system     = 'freebsd'
cpu_family = 'x86_64'
cpu        = 'x86_64'
endian     = 'little'

# ⚠ @ORBIS_COMPAT@ COMES FIRST, and it has to. orbis-compat's bits/alltypes.h corrects four pthread
# types this SDK declares smaller than Sony writes, and it works by defining musl's own
# __DEFINED_<name> guards before musl's copy is reached. Behind the SDK's directory it would compile,
# do nothing, and say nothing.
#
# ⚠ THE INCLUDE PATH IS NOT ENOUGH, AND THIS COMMENT USED TO SAY IT WAS. The reasoning below is sound
# about the FINAL ARTIFACT and wrong about CONFIGURE: Mesa builds a static archive here, so the
# overlay's own liborbis-compat.a really is linked by whoever links the executable - the title and the
# CTS, both of which do. But meson's cc.has_function() is a LINK TEST, run long before any of that.
#
# unistd.h below does `#define sysconf orbis_sysconf` and puts orbis_sysconf in liborbis-compat.a. With
# only the include path on the line, meson's probe for sysconf compiled fine and then died on
# `undefined symbol: orbis_sysconf` - so HAVE_SYSCONF went unset, and util/os_misc.c fell into the arm
# that util/detect_os.h:47 documents as "guarded by HAVE_SYSCONF, therefore unreachable". It was
# reachable, and it broke the plain Vulkan-only build of Mesa with `#error Unsupported *BSD` - three
# hundred files after the actual cause, which is why this is spelled out here rather than there.
#
# So the library goes on the link line too. Measured before doing it: this changes EXACTLY ONE
# preprocessor define across a full Mesa build - -DHAVE_SYSCONF appears, nothing else moves. It is
# ahead of -lc because it forwards to libc's own symbols and static link order is resolution order.
#
# ⚠ -DENODATA=61 USED TO BE ON BOTH LINES ABOVE, and it is orbis-compat's errno.h now. Mesa defines
# ENODATA itself for FreeBSD (radv_amdgpu_cs.c: `#define ENODATA ECONNREFUSED` under
# DETECT_OS_FREEBSD), but this port deliberately does not set DETECT_OS_FREEBSD, so that arm never
# fired and the value had to be forced from here. Same value - 61 IS ECONNREFUSED in this SDK's
# FreeBSD-numbered errno table - in a header that says why, rather than a bare number on a command
# line that does not.
#
# It is also the ONLY include path this build adds ahead of the SDK. @ORBIS_CROSS@ used to carry six
# headers copied out of build-support/orbis/shims; they are orbis-compat's now, and the prefix holds
# nothing but an empty pkgconfig directory.

[built-in options]
c_args   = ['--target=x86_64-pc-freebsd12-elf','--sysroot=@OO_PS4_TOOLCHAIN@','-fPIC','-funwind-tables','-D__PS4__','-DPS4','-D__ORBIS__','-D_BSD_SOURCE=1','-isysroot','@OO_PS4_TOOLCHAIN@','-isystem','@ORBIS_COMPAT@/include','-isystem','@OO_PS4_TOOLCHAIN@/include']
cpp_args = ['--target=x86_64-pc-freebsd12-elf','--sysroot=@OO_PS4_TOOLCHAIN@','-fPIC','-funwind-tables','-D__PS4__','-DPS4','-D__ORBIS__','-D_BSD_SOURCE=1','-isysroot','@OO_PS4_TOOLCHAIN@','-isystem','@ORBIS_COMPAT@/include','-isystem','@OO_PS4_TOOLCHAIN@/include/c++/v1','-isystem','@OO_PS4_TOOLCHAIN@/include']
# The link line is the SDK's own: no libc, lld, a linker script, and crt1.o last.
#
# ⚠ --sysroot IS LOAD-BEARING, not tidiness. -nostdlib removes the default LIBRARIES, not the default
# library SEARCH PATHS, so ld.lld happily resolved -lelf to /usr/lib/libelf.so - the host's, for a
# freebsd12-elf target - and Mesa's cc.find_library('elf') therefore reported YES. Every cc.find_library
# in the tree was exposed to the same mistake. With --sysroot those paths become @OO_PS4_TOOLCHAIN@/usr/lib
# and do not exist.
c_link_args   = ['--target=x86_64-pc-freebsd12-elf','--sysroot=@OO_PS4_TOOLCHAIN@','-nostdlib','-fuse-ld=lld','-pie','-Wl,-m,elf_x86_64','-Wl,--script=@ORBIS_COMPAT@/cmake/orbis-tls.ld','-Wl,--eh-frame-hdr','-Wl,--no-rosegment','-L@OO_PS4_TOOLCHAIN@/lib','-L@ORBIS_COMPAT@/build','-lorbis-compat','-lc','-lkernel','-lc++','@OO_PS4_TOOLCHAIN@/lib/crt1.o']
cpp_link_args = ['--target=x86_64-pc-freebsd12-elf','--sysroot=@OO_PS4_TOOLCHAIN@','-nostdlib','-fuse-ld=lld','-pie','-Wl,-m,elf_x86_64','-Wl,--script=@ORBIS_COMPAT@/cmake/orbis-tls.ld','-Wl,--eh-frame-hdr','-Wl,--no-rosegment','-L@OO_PS4_TOOLCHAIN@/lib','-L@ORBIS_COMPAT@/build','-lorbis-compat','-lc','-lkernel','-lc++','@OO_PS4_TOOLCHAIN@/lib/crt1.o']

[properties]
pkg_config_libdir = '@ORBIS_CROSS@/lib/pkgconfig'
needs_exe_wrapper = true
